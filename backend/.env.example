# Copy to .env and fill in. Never commit .env.
PORT=5000
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Random secret used to sign login tokens (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
AUTH_SECRET=
# Admin console credentials. Generate the hash with: node setup-env.js admin@law4u.in "YourPassword"  (writes this whole file)
ADMIN_EMAIL=admin@law4u.in
ADMIN_PASSWORD_HASH=Admin@123
